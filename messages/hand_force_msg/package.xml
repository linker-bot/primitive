<?xml version="1.0"?>
<package format="3">
  <name>hand_force_msg</name>
  <version>0.0.1</version>
  <description>Message definitions for hand sensors (tactile force)</description>
  <maintainer email="dev@evolabs.cn">EvoLabs</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <build_depend>std_msgs</build_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- CMakeLists 在 BUILD_TESTING 下 find_package(ament_lint_auto REQUIRED) -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
